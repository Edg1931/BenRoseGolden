# Supabase — copy to .env.local and fill in. When unset, the app falls back to
# in-memory seed data so the UI works in local dev without a live database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by privileged operations and never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, Module 2: Down Payment Resource API (swap-in data source, later).
DPR_API_BASE_URL=
DPR_API_KEY=

# Module 2: AI program refresh. When set, the "Refresh with AI" button (Golden
# Group / admin only) uses Claude + web search to research current Ohio DPA/grant
# programs and stage them for human review. When unset, the button is disabled.
ANTHROPIC_API_KEY=

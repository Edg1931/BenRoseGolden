# Supabase — copy to .env.local and fill in. When unset, the app falls back to
# in-memory seed data so the UI works in local dev without a live database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by privileged operations and never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, Module 2: Down Payment Resource API (swap-in data source, later).
DPR_API_BASE_URL=
DPR_API_KEY=

# Module 2: AI program refresh. When set, the "Refresh with AI" button (Golden
# Group / admin only) uses Claude + web search to research current Ohio DPA/grant
# programs and stage them for human review. When unset, the button is disabled.
# This key also powers the learner "Ask AI Coach".
ANTHROPIC_API_KEY=

# Module 2: scheduled program refresh. CRON_SECRET protects the weekly Vercel
# Cron job (/api/cron/refresh-programs); set the same value in Vercel's env so
# Vercel sends it as a Bearer token. The job stores fresh candidates as a review
# queue in Supabase (requires SUPABASE_SERVICE_ROLE_KEY) — it never auto-publishes.
# The service-role key also lets the public finder read staff-approved programs.
CRON_SECRET=

# Module 3: email delivery (Resend). When RESEND_API_KEY is set, "ready"
# newsletters can actually be sent to their audience and "Send content" can
# email assets to clients. When unset, those actions are logged to the timeline
# but not delivered. EMAIL_FROM must be a verified sender on your Resend account.
RESEND_API_KEY=
EMAIL_FROM="Benjamin Rose Housing <housing@example.org>"

# Module 3: newsletter source material. The "Compose with AI" page offers recent
# articles/resources to pull into a newsletter. When NEWS_FEED_URL points at an
# RSS/Atom feed (e.g. the Benjamin Rose blog), the latest posts are fetched live
# (cached 6h) and shown first. When unset, a curated set of real, housing-relevant
# links is used. NEWS_FEED_SOURCE_NAME labels live items (default "Benjamin Rose").
NEWS_FEED_URL=
NEWS_FEED_SOURCE_NAME="Benjamin Rose"

# Reviews. The /reviews page and the homepage reviews section always show
# "Review us on …" buttons; these vars point them at the org's real profiles and
# (optionally) pull live Google reviews.
#
# Public "read/leave a review" links (safe to expose; shown as buttons):
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
NEXT_PUBLIC_GOOGLE_WRITE_REVIEW_URL=
NEXT_PUBLIC_FACEBOOK_REVIEWS_URL=
NEXT_PUBLIC_ZILLOW_REVIEWS_URL=
#
# Optional live Google reviews. When BOTH are set, the site fetches the latest
# Google rating + reviews (cached 24h) via the Places API. When unset, the
# curated FEATURED_REVIEWS (lib/reviews/config.ts) are shown instead. The key is
# server-only. Find the Place ID at:
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
